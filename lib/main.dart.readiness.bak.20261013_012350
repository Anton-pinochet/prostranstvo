class _SpaceScreenState extends State<SpaceScreen> {
  final TextEditingController _messageController = TextEditingController();
  final ScrollController _scrollController = ScrollController();
  List<String> _messages = [];
  bool _isTyping = false;
  String _aiStatus = 'Сканирую устройство...';
  DeviceProfile? _device;
  String _selectedMode = 'auto';

  // ==== LLM ====
  final LlamaController _llm = LlamaController();
  bool _llmReady = false;
  String _llmStatus = 'LLM не загружена';
  StreamSubscription<String>? _llmSub;
  String _llmBuffer = '';
  int _userMessageCount = 0;
  int _summaryAtCount = 0;
  int _lastUserWordsCount = 0;
  bool _lastMentionsPerson = false;
  bool _lastMentionsTask = false;
  bool _lastMentionsFeeling = false;
  bool _lastShort = false;
  bool _lastLong = false;
  bool _lastSaysDontKnow = false;
  bool _lastAsksAdvice = false;
  String _knownFeeling = '';
  bool _userToldTheProblem = false;

  @override
  void initState() {
    super.initState();
    _init();
    _initLLM();
  }

  Future<void> _init() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('user_name', widget.name);
    await prefs.setString('user_city', widget.city);

    final device = await DeviceMonitor.scan();
    setState(() => _device = device);

    _selectedMode = prefs.getString('ai_mode') ?? 'auto';

    setState(() {
      _aiStatus = 'Режим: ${_modeLabel(_selectedMode)} (RAM: ${device.ramMB} МБ)';
    });

    await _loadMessages();
  }

  Future<void> _initLLM() async {
    try {
      setState(() => _llmStatus = 'Проверяю модель...');
      final docDir = await getApplicationDocumentsDirectory();
      final modelPath = p.join(docDir.path, 'qwen2.5-1.5b-instruct-q4_k_m.gguf');
      final modelFile = File(modelPath);

      const url = 'https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf';
      const totalSize = 1117320736;
      const chunkSize = 10 * 1024 * 1024;

      int downloaded = 0;
      if (await modelFile.exists()) {
        final actualSize = await modelFile.length();
        if (actualSize == totalSize) {
          downloaded = totalSize;
          setState(() => _llmStatus = 'Модель уже скачана');
        } else if (actualSize < totalSize) {
          downloaded = actualSize;
          setState(() => _llmStatus = 'Продолжаю с ' + (downloaded ~/ 1024 ~/ 1024).toString() + ' МБ...');
        } else {
          await modelFile.delete();
          downloaded = 0;
        }
      }

      if (downloaded < totalSize) {
        final raf = await modelFile.open(mode: FileMode.append);
        final client = http.Client();

        try {
          while (downloaded < totalSize) {
            final from = downloaded;
            final to = (from + chunkSize < totalSize) ? from + chunkSize - 1 : totalSize - 1;
            final req = http.Request('GET', Uri.parse(url));
            req.headers['Range'] = 'bytes=' + from.toString() + '-' + to.toString();
            final resp = await client.send(req);

            if (resp.statusCode != 206 && resp.statusCode != 200) {
              throw Exception('HTTP ' + resp.statusCode.toString());
            }

            final chunk = await resp.stream.toBytes();
            await raf.writeFrom(chunk);
            downloaded += chunk.length;

            final percent = (downloaded * 100 / totalSize).toStringAsFixed(1);
            setState(() => _llmStatus = 'Скачивание: ' + percent + '%');
            await Future.delayed(const Duration(milliseconds: 50));
          }
        } finally {
          client.close();
          await raf.close();
        }
      }

      final finalSize = await modelFile.length();
      if (finalSize != totalSize) {
        throw Exception('Файл неполный');
      }

      setState(() => _llmStatus = 'Загружаю модель в память...');
      await _llm.loadModel(
        modelPath: modelPath,
        threads: 4,
        contextSize: 2048,
      );

      if (!mounted) return;
      setState(() {
        _llmReady = true;
        _llmStatus = 'LLM готова (Qwen 1.5B)';
      });
    } catch (e, st) {
      debugPrint('LLM init error: ' + e.toString());
      if (!mounted) return;
      setState(() => _llmStatus = 'Ошибка LLM: ' + e.toString());
    }
  }

  String _modeLabel(String mode) {
    switch (mode) {
      case 'auto': return 'Авто (${_recommendedLabel()})';
      case 'cloud': return 'Облако';
      case 'qwen_05b': return 'Qwen 0.5B';
      case 'qwen_15b': return 'Qwen 1.5B';
      case 'qwen_3b': return 'Qwen 3B';
      default: return mode;
    }
  }

  String _recommendedLabel() {
    if (_device == null) return '...';
    switch (_device!.recommendedMode) {
      case 'cloud': return 'Облако';
      case 'qwen_05b': return 'Qwen 0.5B';
      case 'qwen_15b': return 'Qwen 1.5B';
      case 'qwen_3b': return 'Qwen 3B';
      default: return '...';
    }
  }

  @override
  void dispose() {
    _llmSub?.cancel();
    _llm.dispose();
    _messageController.dispose();
    _scrollController.dispose();
    super.dispose();
  }

  void _scrollToBottom() {
    if (_scrollController.hasClients) {
      Future.delayed(const Duration(milliseconds: 100), () {
        _scrollController.animateTo(
          _scrollController.position.maxScrollExtent,
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeOut,
        );
      });
    }
  }

  Future<void> _loadMessages() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = prefs.getStringList('chat_history');
    if (saved != null) {
      setState(() => _messages = saved);
      WidgetsBinding.instance.addPostFrameCallback((_) => _scrollToBottom());
    }
  }

  Future<void> _saveMessages() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setStringList('chat_history', _messages);
  }

  Future<void> _clearAll() async {
    _llmSub?.cancel();
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove('chat_history');
    setState(() {
      _messages = [];
      _llmBuffer = '';
      _isTyping = false;
      _userMessageCount = 0;
      _summaryAtCount = 0;
      _userToldTheProblem = false;
      _knownFeeling = '';
    });
    final prefsClear = await SharedPreferences.getInstance();
    await prefsClear.remove('dialog_summary');
    await prefsClear.remove('summary_at_count');
  }

  Future<List<ChatMessage>> _buildChatHistory(String userText) async {
    final prefs = await SharedPreferences.getInstance();
    final name = prefs.getString('user_name') ?? 'друг';
    final city = prefs.getString('user_city') ?? '';
    final timeOfDay = _getTimeOfDay();
    final summary = prefs.getString('dialog_summary') ?? '';

    final stage = _userMessageCount;
    final stageInstruction = _stageInstruction(stage);

    final summaryBlock = summary.isNotEmpty
        ? '\n\nЧто уже известно о ситуации (из прошлого анализа):\n' + summary + '\n'
        : '';

    final systemPrompt = 'Ты — тёплый, внимательный ассистент-собеседник приложения «Пространство». '
        'Пользователя зовут ' + name + (city.isNotEmpty ? ', он из города ' + city : '') + '. '
        'Сейчас у него ' + timeOfDay + '. '
        '\n\n'
        'Ты ведёшь диалог по технике «воронка вопросов». '
        'Твоя задача — понять суть проблемы за 5-7 обменов репликами. '
        'Правила: '
        '— НЕ задавай два вопроса в одном сообщении. '
        '— НЕ спеши с советом — сначала пойми. '
        '— Отражай чувства собеседника своими словами. '
        '— Обращайся по имени. '
        '— Пиши 2-4 предложения. '
        '— В конце — ОДИН мягкий вопрос.'
        + summaryBlock +
        '\n\nТвой текущий этап воронки:\n' + stageInstruction;

    final result = <ChatMessage>[
      ChatMessage(role: 'system', content: systemPrompt),
    ];

    final filtered = <String>[];
    for (final m in _messages) {
      if (m.startsWith('⚠️') || m.startsWith('[Режим') || m.startsWith('[Ассистент]')) continue;
      filtered.add(m);
    }
    for (var i = 0; i < filtered.length; i++) {
      final role = (i % 2 == 0) ? 'user' : 'assistant';
      result.add(ChatMessage(role: role, content: filtered[i]));
    }

    result.add(ChatMessage(role: 'user', content: userText));
    return result;
  }

  void _analyzeLastMessage(String text) {
    final lower = text.toLowerCase();
    final words = lower.split(RegExp(r'\s+')).where((w) => w.isNotEmpty).toList();
    _lastUserWordsCount = words.length;
    _lastShort = words.length < 10;
    _lastLong = words.length > 30;

    _lastMentionsPerson = ['начальник', 'шеф', 'руководител', 'коллег', 'жена',
                            'муж', 'партнёр', 'партнер', 'мама', 'папа', 'он', 'она']
                            .any((w) => lower.contains(w));
    _lastMentionsTask = ['задач', 'проект', 'работ', 'дедлайн', 'отчёт', 'отчет']
                            .any((w) => lower.contains(w));
    _lastMentionsFeeling = ['бессил', 'злост', 'устал', 'обид', 'тревог',
                             'страх', 'выгор', 'раздраж', 'груст', 'одинок']
                             .any((w) => lower.contains(w));
    _lastSaysDontKnow = ['не знаю', 'не понимаю', 'не могу понять']
                            .any((w) => lower.contains(w));
    _lastAsksAdvice = ['что делать', 'как быть', 'посоветуй', 'помоги', 'подскажи']
                            .any((w) => lower.contains(w));

    if (_lastMentionsFeeling) {
      for (final f in ['бессил', 'злост', 'устал', 'обид', 'тревог', 'выгор', 'одинок']) {
        if (lower.contains(f)) { _knownFeeling = f; break; }
      }
    }

    if (_lastLong || (_lastMentionsPerson && _lastMentionsFeeling)) {
      _userToldTheProblem = true;
    }
  }

  String _stageInstruction(int stage) {
    if (_lastAsksAdvice) {
      return 'Пользователь просит совета. Мягко предложи одну технику, '
          'которая подходит к его ситуации. Не читай лекцию — 2-3 предложения.';
    }
    if (stage == 0) {
      return 'Узнай мягко, с чем человек пришёл. Один общий вопрос.';
    }
    if (_userToldTheProblem) {
      if (_lastMentionsFeeling) {
        return 'Пользователь назвал чувство (' + _knownFeeling + '). '
            'Отражай его своими словами и углубляй: что это чувство хочет сказать? '
            'Где оно в теле? Когда оно сильнее всего?';
      }
      if (_lastMentionsPerson) {
        return 'Пользователь говорит про человека. Спроси, что в общении '
            'с ним задевает сильнее всего.';
      }
      if (_lastMentionsTask) {
        return 'Пользователь говорит про задачу. Спроси, что именно в ней '
            'тяжело — объём, сроки, смысл?';
      }
      return 'Отражай услышанное и углубляй по теме. НЕ задавай общий вопрос.';
    }
    if (_lastShort) {
      return 'Пользователь ответил коротко. Мягко попроси рассказать чуть подробнее. '
          'Не дави, не допрашивай.';
    }
    if (_lastSaysDontKnow) {
      return 'Пользователь говорит «не знаю». Помоги ему сузить: '
          'спроси, а если бы пришлось выбрать одно — что бы это было?';
    }
    return 'Отражай услышанное. Задавай вопрос только если он уместен. '
        'Не превращай разговор в анкету.';
  }

  Future<void> _updateDialogSummary() async {
    if (_messages.length < 4) return;

    final prefs = await SharedPreferences.getInstance();
    final recent = _messages.length > 8
        ? _messages.sublist(_messages.length - 8)
        : _messages;

    final summaryPrompt = 'Проанализируй диалог и напиши краткое summary в 3-4 предложениях. '
        'Что важно: с чем пришёл человек, какие темы, какие чувства, что уже обсуждали. '
        'Без советов — только суть.\n\nДиалог:\n'
        + recent.join('\n')
        + '\n\nSummary:';

    final buffer = StringBuffer();
    try {
      await for (final token in _llm.generateChat(
        messages: [ChatMessage(role: 'user', content: summaryPrompt)],
        maxTokens: 150,
        temperature: 0.3,
      )) {
        buffer.write(token);
      }
      final summary = buffer.toString().trim();
      if (summary.isNotEmpty) {
        await prefs.setString('dialog_summary', summary);
        await prefs.setInt('summary_at_count', _userMessageCount);
        _summaryAtCount = _userMessageCount;
        debugPrint('[SUMMARY] ' + summary);
      }
    } catch (e) {
      debugPrint('[SUMMARY error] ' + e.toString());
    }
  }

  String _getTimeOfDay() {
    final hour = DateTime.now().hour;
    if (hour < 6) return 'ночь';
    if (hour < 12) return 'утро';
    if (hour < 18) return 'день';
    return 'вечер';
  }

  Future<void> _generateReply(String userText) async {
    if (!_llmReady) {
      setState(() {
        _messages.add('⚠️ LLM ещё не готова. Подожди... ($_llmStatus)');
        _isTyping = false;
      });
      _saveMessages();
      return;
    }

    setState(() {
      _llmBuffer = '';
      _isTyping = true;
    });

    try {
      final history = await _buildChatHistory(userText);
      _llmSub?.cancel();

      int assistantIndex = -1;
      _llmSub = _llm
          .generateChat(
            messages: history,
            maxTokens: 300,
            temperature: 0.85,
            topP: 0.92,
            topK: 50,
            repeatPenalty: 1.15,
          )
          .listen(
        (token) {
          if (!mounted) return;
          _llmBuffer += token;
          setState(() {
            if (assistantIndex == -1) {
              _messages.add('[Ассистент] $_llmBuffer');
              assistantIndex = _messages.length - 1;
            } else {
              _messages[assistantIndex] = '[Ассистент] $_llmBuffer';
            }
          });
          _scrollToBottom();
        },
        onDone: () async {
          if (!mounted) return;
          setState(() => _isTyping = false);
          _saveMessages();
          if (_userMessageCount > 0 && _userMessageCount % 4 == 0 && _userMessageCount != _summaryAtCount) {
            await _updateDialogSummary();
          }
        },
        onError: (e) {
          if (!mounted) return;
          setState(() {
            _messages.add('⚠️ Ошибка генерации: $e');
            _isTyping = false;
          });
          _saveMessages();
        },
      );
    } catch (e, st) {
      debugPrint('generateChat error: $e\n$st');
      setState(() {
        _messages.add('⚠️ Ошибка: $e');
        _isTyping = false;
      });
      _saveMessages();
    }
  }

  Future<void> _sendMessage() async {
    final text = _messageController.text.trim();
    if (text.isEmpty || _isTyping) return;

    _analyzeLastMessage(text);

    setState(() {
      _messages.add(text);
      _messageController.clear();
      _isTyping = true;
      _userMessageCount++;
    });
    _saveMessages();
    _scrollToBottom();

    await _generateReply(text);
  }


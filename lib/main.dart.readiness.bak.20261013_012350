                    Expanded(
                      child: _messages.isEmpty
                          ? const Center(child: Text('Напиши что-нибудь...', style: TextStyle(color: Colors.white54)))
                          : ListView.builder(
                              controller: _scrollController,
                              itemCount: _messages.length,
                              itemBuilder: (context, index) {
                                final actualIndex = index;
                                final isUser = actualIndex % 2 == 0;
                                return Align(
                                  alignment: isUser ? Alignment.centerRight : Alignment.centerLeft,
                                  child: Container(
                                    margin: const EdgeInsets.symmetric(vertical: 4),
                                    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                                    decoration: BoxDecoration(
                                      color: isUser ? Colors.white.withOpacity(0.1) : Colors.transparent,
                                      borderRadius: BorderRadius.circular(16),
                                    ),
                                    child: Text(
                                      _messages[actualIndex],
                                      style: TextStyle(color: isUser ? Colors.white : const Color(0xFFE6C9A8), fontSize: 16),
                                    ),
                                  ),
                                );
                              },
                            ),
                    ),
                    if (_isTyping)
                      const Padding(
                        padding: EdgeInsets.symmetric(vertical: 8.0),
                        child: Row(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2, color: Color(0xFFE6C9A8))),
                            SizedBox(width: 8),
                            Text('ИИ печатает...', style: TextStyle(color: Colors.white54, fontSize: 12)),
                          ],
                        ),
                      ),
                    Row(
                      children: [
                        Expanded(
                          child: TextField(
                            controller: _messageController,
                            enabled: !_isTyping,
                            style: const TextStyle(color: Colors.white),
                            decoration: InputDecoration(
                              hintText: 'Как ты себя чувствуешь?',
                              hintStyle: TextStyle(color: Colors.white.withOpacity(0.3)),
                              filled: true,
                              fillColor: Colors.white.withOpacity(0.05),
                              border: OutlineInputBorder(borderRadius: BorderRadius.circular(24), borderSide: BorderSide.none),
                              contentPadding: const EdgeInsets.symmetric(horizontal: 20, vertical: 14),
                            ),
                            onSubmitted: (_) => _sendMessage(),
                          ),
                        ),
                        const SizedBox(width: 8),
                        IconButton(
                          onPressed: _isTyping ? null : _sendMessage,
                          icon: const Icon(Icons.arrow_upward, color: Color(0xFFE6C9A8)),
                          style: IconButton.styleFrom(backgroundColor: Colors.white.withOpacity(0.05)),
                        ),
                      ],
                    ),
                    const SizedBox(height: 8),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  void _showSettings() {
    if (_device == null) return;
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: const Color(0xFF2A2B2E),
        title: const Text('Настройки ИИ', style: TextStyle(color: Color(0xFFE6C9A8))),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text('Устройство:', style: TextStyle(color: Color(0xFFE6C9A8), fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              Text('Модель: ${_device!.model}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('Android: ${_device!.androidVersion}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('RAM: ${_device!.ramMB} МБ', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('CPU ядер: ${_device!.cpuCores}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('ABI: ${_device!.abi}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              const SizedBox(height: 12),
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(color: Colors.white.withOpacity(0.05), borderRadius: BorderRadius.circular(8)),
                child: Text('Статус LLM: $_llmStatus', style: const TextStyle(color: Color(0xFFE6C9A8), fontSize: 13)),
              ),
              const SizedBox(height: 16),
              const Text('Режим работы:', style: TextStyle(color: Color(0xFFE6C9A8), fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              _modeOption('auto', 'Авто (рекомендуется)'),
              _modeOption('cloud', 'Облако (BYOK)'),
              if (_device!.supportsLocalLLM) ...[
                _modeOption('qwen_05b', 'Qwen 0.5B (~400 МБ)'),
                _modeOption('qwen_15b', 'Qwen 1.5B (~940 МБ)'),
                if (_device!.ramMB >= 6000) _modeOption('qwen_3b', 'Qwen 3B (~2 ГБ)'),
              ] else ...[
                Padding(
                  padding: const EdgeInsets.only(top: 8),
                  child: Text('⚠️ Локальные модели недоступны: мало RAM (нужно ≥ 3 ГБ)',
                      style: TextStyle(color: Colors.orange.withOpacity(0.8), fontSize: 12)),
                ),
              ],
            ],
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context), child: const Text('Закрыть', style: TextStyle(color: Colors.white54))),
        ],
      ),
    );
  }

  Widget _modeOption(String value, String label) {
    return RadioListTile<String>(
      value: value,
      groupValue: _selectedMode,
      onChanged: (v) async {
        setState(() => _selectedMode = v ?? 'auto');
        final prefs = await SharedPreferences.getInstance();
        await prefs.setString('ai_mode', _selectedMode);
        if (mounted) setState(() => _aiStatus = 'Режим: ${_modeLabel(_selectedMode)} (RAM: ${_device!.ramMB} МБ)');
      },
      title: Text(label, style: const TextStyle(color: Colors.white, fontSize: 13)),
      activeColor: const Color(0xFFE6C9A8),
      dense: true,
      contentPadding: EdgeInsets.zero,
    );
  }
}

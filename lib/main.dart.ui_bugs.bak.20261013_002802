class DeviceProfile {
  final int ramMB;
  final int cpuCores;
  final String abi;
  final String model;
  final String androidVersion;

  DeviceProfile({
    required this.ramMB,
    required this.cpuCores,
    required this.abi,
    required this.model,
    required this.androidVersion,
  });

  String get recommendedMode {
    if (ramMB < 3000) return 'cloud';
    if (ramMB < 4000) return 'qwen_05b';
    if (ramMB < 6000) return 'qwen_15b';
    return 'qwen_3b';
  }

  bool get supportsLocalLLM => ramMB >= 3000;
}

class DeviceMonitor {
  static Future<DeviceProfile> scan() async {
    final deviceInfo = DeviceInfoPlugin();
    final androidInfo = await deviceInfo.androidInfo;

    int ramMB = 0;
    try {
      final meminfo = await File('/proc/meminfo').readAsString();
      final match = RegExp(r'MemTotal:\s+(\d+)\s+kB').firstMatch(meminfo);
      if (match != null) {
        ramMB = (int.parse(match.group(1)!) / 1024).round();
      }
    } catch (_) {}

    return DeviceProfile(
      ramMB: ramMB,
      cpuCores: Platform.numberOfProcessors,
      abi: androidInfo.supportedAbis.isNotEmpty ? androidInfo.supportedAbis.first : 'unknown',
      model: androidInfo.model,
      androidVersion: androidInfo.version.release,
    );
  }
}


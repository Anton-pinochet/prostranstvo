class SpaceScreen extends StatefulWidget {
  final String name;
  final String city;
  const SpaceScreen({super.key, required this.name, required this.city});
  @override
  State<SpaceScreen> createState() => _SpaceScreenState();
}

class _SpaceScreenState extends State<SpaceScreen> {
  final TextEditingController _messageController = TextEditingController();
  final ScrollController _scrollController = ScrollController();
  List<String> _messages = [];
  bool _isTyping = false;
  String _aiStatus = 'Сканирую устройство...';
  DeviceProfile? _device;
  String _selectedMode = 'auto';

  // ==== LLM ====
  final LlamaController _llm = LlamaController();
  bool _llmReady = false;
  String _llmStatus = 'LLM не загружена';
  StreamSubscription<String>? _llmSub;
  String _llmBuffer = '';

  @override
  void initState() {
    super.initState();
    _init();
    _initLLM();
  }

  Future<void> _init() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('user_name', widget.name);
    await prefs.setString('user_city', widget.city);

    final device = await DeviceMonitor.scan();
    setState(() => _device = device);

    _selectedMode = prefs.getString('ai_mode') ?? 'auto';

    setState(() {
      _aiStatus = 'Режим: ${_modeLabel(_selectedMode)} (RAM: ${device.ramMB} МБ)';
    });

    await _loadMessages();
  }

  Future<void> _initLLM() async {
    try {
      setState(() => _llmStatus = 'Проверяю модель...');
      final docDir = await getApplicationDocumentsDirectory();
      final modelPath = p.join(docDir.path, 'qwen2.5-1.5b-instruct-q4_k_m.gguf');
      final modelFile = File(modelPath);

      const url = 'https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf';
      const totalSize = 1117320736;
      const chunkSize = 10 * 1024 * 1024;

      int downloaded = 0;
      if (await modelFile.exists()) {
        final actualSize = await modelFile.length();
        if (actualSize == totalSize) {
          downloaded = totalSize;
          setState(() => _llmStatus = 'Модель уже скачана');
        } else if (actualSize < totalSize) {
          downloaded = actualSize;
          setState(() => _llmStatus = 'Продолжаю с ' + (downloaded ~/ 1024 ~/ 1024).toString() + ' МБ...');
        } else {
          await modelFile.delete();
          downloaded = 0;
        }
      }

      if (downloaded < totalSize) {
        final raf = await modelFile.open(mode: FileMode.append);
        final client = http.Client();

        try {
          while (downloaded < totalSize) {
            final from = downloaded;
            final to = (from + chunkSize < totalSize) ? from + chunkSize - 1 : totalSize - 1;
            final req = http.Request('GET', Uri.parse(url));
            req.headers['Range'] = 'bytes=' + from.toString() + '-' + to.toString();
            final resp = await client.send(req);

            if (resp.statusCode != 206 && resp.statusCode != 200) {
              throw Exception('HTTP ' + resp.statusCode.toString());
            }

            final chunk = await resp.stream.toBytes();
            await raf.writeFrom(chunk);
            downloaded += chunk.length;

            final percent = (downloaded * 100 / totalSize).toStringAsFixed(1);
            setState(() => _llmStatus = 'Скачивание: ' + percent + '%');
            await Future.delayed(const Duration(milliseconds: 50));
          }
        } finally {
          client.close();
          await raf.close();
        }
      }

      final finalSize = await modelFile.length();
      if (finalSize != totalSize) {
        throw Exception('Файл неполный');
      }

      setState(() => _llmStatus = 'Загружаю модель в память...');
      await _llm.loadModel(
        modelPath: modelPath,
        threads: 4,
        contextSize: 2048,
      );

      if (!mounted) return;
      setState(() {
        _llmReady = true;
        _llmStatus = 'LLM готова (Qwen 1.5B)';
      });
    } catch (e, st) {
      debugPrint('LLM init error: ' + e.toString());
      if (!mounted) return;
      setState(() => _llmStatus = 'Ошибка LLM: ' + e.toString());
    }
  }

  String _modeLabel(String mode) {
    switch (mode) {
      case 'auto': return 'Авто (${_recommendedLabel()})';
      case 'cloud': return 'Облако';
      case 'qwen_05b': return 'Qwen 0.5B';
      case 'qwen_15b': return 'Qwen 1.5B';
      case 'qwen_3b': return 'Qwen 3B';
      default: return mode;
    }
  }

  String _recommendedLabel() {
    if (_device == null) return '...';
    switch (_device!.recommendedMode) {
      case 'cloud': return 'Облако';
      case 'qwen_05b': return 'Qwen 0.5B';
      case 'qwen_15b': return 'Qwen 1.5B';
      case 'qwen_3b': return 'Qwen 3B';
      default: return '...';
    }
  }

  @override
  void dispose() {
    _llmSub?.cancel();
    _llm.dispose();
    _messageController.dispose();
    _scrollController.dispose();
    super.dispose();
  }

  void _scrollToBottom() {
    if (_scrollController.hasClients) {
      Future.delayed(const Duration(milliseconds: 100), () {
        _scrollController.animateTo(
          _scrollController.position.maxScrollExtent,
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeOut,
        );
      });
    }
  }

  Future<void> _loadMessages() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = prefs.getStringList('chat_history');
    if (saved != null) {
      setState(() => _messages = saved);
      WidgetsBinding.instance.addPostFrameCallback((_) => _scrollToBottom());
    }
  }

  Future<void> _saveMessages() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setStringList('chat_history', _messages);
  }

  Future<void> _clearAll() async {
    _llmSub?.cancel();
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove('chat_history');
    setState(() {
      _messages = [];
      _llmBuffer = '';
      _isTyping = false;
    });
  }

  List<ChatMessage> _buildChatHistory(String userText) {
    final result = <ChatMessage>[
      ChatMessage(
        role: 'system',
        content: 'Ты — ментальный ассистент «Пространство». Отвечай коротко, поддерживающе, по-русски. Не давай медицинских диагнозов.',
      ),
    ];

    for (var i = 0; i < _messages.length; i++) {
      final m = _messages[i];
      if (m.startsWith('⚠️') || m.startsWith('[Режим') || m.startsWith('[Ассистент]')) continue;
      final role = (i % 2 == 0) ? 'user' : 'assistant';
      result.add(ChatMessage(role: role, content: m));
    }

    result.add(ChatMessage(role: 'user', content: userText));
    return result;
  }

  Future<void> _generateReply(String userText) async {
    if (!_llmReady) {
      setState(() {
        _messages.add('⚠️ LLM ещё не готова. Подожди... ($_llmStatus)');
        _isTyping = false;
      });
      _saveMessages();
      return;
    }

    setState(() {
      _llmBuffer = '';
      _isTyping = true;
    });

    try {
      final history = _buildChatHistory(userText);
      _llmSub?.cancel();

      int assistantIndex = -1;
      _llmSub = _llm
          .generateChat(
            messages: history,
            maxTokens: 512,
            temperature: 0.7,
            topP: 0.9,
            topK: 40,
            repeatPenalty: 1.1,
          )
          .listen(
        (token) {
          if (!mounted) return;
          _llmBuffer += token;
          setState(() {
            if (assistantIndex == -1) {
              _messages.add('[Ассистент] $_llmBuffer');
              assistantIndex = _messages.length - 1;
            } else {
              _messages[assistantIndex] = '[Ассистент] $_llmBuffer';
            }
          });
          _scrollToBottom();
        },
        onDone: () {
          if (!mounted) return;
          setState(() => _isTyping = false);
          _saveMessages();
        },
        onError: (e) {
          if (!mounted) return;
          setState(() {
            _messages.add('⚠️ Ошибка генерации: $e');
            _isTyping = false;
          });
          _saveMessages();
        },
      );
    } catch (e, st) {
      debugPrint('generateChat error: $e\n$st');
      setState(() {
        _messages.add('⚠️ Ошибка: $e');
        _isTyping = false;
      });
      _saveMessages();
    }
  }

  Future<void> _sendMessage() async {
    final text = _messageController.text.trim();
    if (text.isEmpty || _isTyping) return;

    setState(() {
      _messages.add(text);
      _messageController.clear();
      _isTyping = true;
    });
    _saveMessages();
    _scrollToBottom();

    await _generateReply(text);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: const Color(0xFF1A1B1E),
        title: Text(
          _llmReady ? 'ИИ: Qwen 1.5B' : _llmStatus,
          style: const TextStyle(color: Color(0xFFE6C9A8), fontSize: 12),
          maxLines: 2,
        ),
        actions: [
          IconButton(icon: const Icon(Icons.settings, color: Color(0xFFE6C9A8)), onPressed: _showSettings),
          IconButton(icon: const Icon(Icons.delete_forever, color: Color(0xFFE6C9A8)), onPressed: _clearAll),
        ],
      ),
      body: SafeArea(
        child: Column(
          children: [
            Expanded(
              flex: 2,
              child: Container(
                color: Colors.blueAccent.withOpacity(0.2),
                child: const Center(child: Text('Rive анимация', style: TextStyle(color: Colors.white))),
              ),
            ),
            Expanded(
              flex: 3,
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                child: Column(
                  children: [
                    Expanded(
                      child: _messages.isEmpty
                          ? const Center(child: Text('Напиши что-нибудь...', style: TextStyle(color: Colors.white54)))
                          : ListView.builder(
                              controller: _scrollController,
                              reverse: true,
                              itemCount: _messages.length,
                              itemBuilder: (context, index) {
                                final actualIndex = _messages.length - 1 - index;
                                final isUser = actualIndex % 2 == 0;
                                return Align(
                                  alignment: isUser ? Alignment.centerRight : Alignment.centerLeft,
                                  child: Container(
                                    margin: const EdgeInsets.symmetric(vertical: 4),
                                    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                                    decoration: BoxDecoration(
                                      color: isUser ? Colors.white.withOpacity(0.1) : Colors.transparent,
                                      borderRadius: BorderRadius.circular(16),
                                    ),
                                    child: Text(
                                      _messages[actualIndex],
                                      style: TextStyle(color: isUser ? Colors.white : const Color(0xFFE6C9A8), fontSize: 16),
                                    ),
                                  ),
                                );
                              },
                            ),
                    ),
                    if (_isTyping)
                      const Padding(
                        padding: EdgeInsets.symmetric(vertical: 8.0),
                        child: Row(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2, color: Color(0xFFE6C9A8))),
                            SizedBox(width: 8),
                            Text('ИИ печатает...', style: TextStyle(color: Colors.white54, fontSize: 12)),
                          ],
                        ),
                      ),
                    Row(
                      children: [
                        Expanded(
                          child: TextField(
                            controller: _messageController,
                            enabled: !_isTyping,
                            style: const TextStyle(color: Colors.white),
                            decoration: InputDecoration(
                              hintText: 'Как ты себя чувствуешь?',
                              hintStyle: TextStyle(color: Colors.white.withOpacity(0.3)),
                              filled: true,
                              fillColor: Colors.white.withOpacity(0.05),
                              border: OutlineInputBorder(borderRadius: BorderRadius.circular(24), borderSide: BorderSide.none),
                              contentPadding: const EdgeInsets.symmetric(horizontal: 20, vertical: 14),
                            ),
                            onSubmitted: (_) => _sendMessage(),
                          ),
                        ),
                        const SizedBox(width: 8),
                        IconButton(
                          onPressed: _isTyping ? null : _sendMessage,
                          icon: const Icon(Icons.arrow_upward, color: Color(0xFFE6C9A8)),
                          style: IconButton.styleFrom(backgroundColor: Colors.white.withOpacity(0.05)),
                        ),
                      ],
                    ),
                    const SizedBox(height: 8),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  void _showSettings() {
    if (_device == null) return;
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: const Color(0xFF2A2B2E),
        title: const Text('Настройки ИИ', style: TextStyle(color: Color(0xFFE6C9A8))),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text('Устройство:', style: TextStyle(color: Color(0xFFE6C9A8), fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              Text('Модель: ${_device!.model}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('Android: ${_device!.androidVersion}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('RAM: ${_device!.ramMB} МБ', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('CPU ядер: ${_device!.cpuCores}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              Text('ABI: ${_device!.abi}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
              const SizedBox(height: 12),
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(color: Colors.white.withOpacity(0.05), borderRadius: BorderRadius.circular(8)),
                child: Text('Статус LLM: $_llmStatus', style: const TextStyle(color: Color(0xFFE6C9A8), fontSize: 13)),
              ),
              const SizedBox(height: 16),
              const Text('Режим работы:', style: TextStyle(color: Color(0xFFE6C9A8), fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              _modeOption('auto', 'Авто (рекомендуется)'),
              _modeOption('cloud', 'Облако (BYOK)'),
              if (_device!.supportsLocalLLM) ...[
                _modeOption('qwen_05b', 'Qwen 0.5B (~400 МБ)'),
                _modeOption('qwen_15b', 'Qwen 1.5B (~940 МБ)'),
                if (_device!.ramMB >= 6000) _modeOption('qwen_3b', 'Qwen 3B (~2 ГБ)'),
              ] else ...[
                Padding(
                  padding: const EdgeInsets.only(top: 8),
                  child: Text('⚠️ Локальные модели недоступны: мало RAM (нужно ≥ 3 ГБ)',
                      style: TextStyle(color: Colors.orange.withOpacity(0.8), fontSize: 12)),
                ),
              ],
            ],
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context), child: const Text('Закрыть', style: TextStyle(color: Colors.white54))),
        ],
      ),
    );
  }

  Widget _modeOption(String value, String label) {
    return RadioListTile<String>(
      value: value,
      groupValue: _selectedMode,
      onChanged: (v) async {
        setState(() => _selectedMode = v ?? 'auto');
        final prefs = await SharedPreferences.getInstance();
        await prefs.setString('ai_mode', _selectedMode);
        if (mounted) setState(() => _aiStatus = 'Режим: ${_modeLabel(_selectedMode)} (RAM: ${_device!.ramMB} МБ)');
      },
      title: Text(label, style: const TextStyle(color: Colors.white, fontSize: 13)),
      activeColor: const Color(0xFFE6C9A8),
      dense: true,
      contentPadding: EdgeInsets.zero,
    );
  }
